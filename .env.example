# Database (PostgreSQL for Docker/VPS, or leave default SQLite for quick local mode)
POSTGRES_USER=leadharvest
POSTGRES_PASSWORD=leadharvest_secret
POSTGRES_DB=leadharvest
LEADHARVEST_DATABASE_URL=postgresql+asyncpg://leadharvest:leadharvest_secret@postgres:5432/leadharvest

# Redis (optional for local dev, recommended in production)
LEADHARVEST_REDIS_URL=redis://redis:6379/0

# Security & Cookies
LEADHARVEST_ENVIRONMENT=development
LEADHARVEST_SECRET_KEY=replace-with-64-char-random-hex-secret
LEADHARVEST_COOKIE_SECURE=false
LEADHARVEST_FRONTEND_URL=http://localhost:3000

# Google OAuth (Optional)
LEADHARVEST_GOOGLE_CLIENT_ID=
LEADHARVEST_GOOGLE_CLIENT_SECRET=

# Razorpay Payments (Use 'simulated' for local testing, 'razorpay' for live/test keys)
LEADHARVEST_PAYMENT_MODE=simulated
LEADHARVEST_RAZORPAY_KEY_ID=
LEADHARVEST_RAZORPAY_KEY_SECRET=
LEADHARVEST_RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# Transactional Email ('console' | 'smtp' | 'resend')
LEADHARVEST_EMAIL_PROVIDER=console
LEADHARVEST_EMAIL_FROM=noreply@leadharvest.in
LEADHARVEST_SMTP_HOST=
LEADHARVEST_SMTP_PORT=587
LEADHARVEST_SMTP_USER=
LEADHARVEST_SMTP_PASSWORD=
LEADHARVEST_RESEND_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
